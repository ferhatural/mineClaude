{
  "name": "mineclaude",
  "version": "1.2.2",
  "description": "Local dashboard for every Claude Code CLI session on your machine, as a Minecraft-ish office: who is working, who is idle, and who is waiting for your input",
  "type": "commonjs",
  "license": "MIT",
  "author": "ferhatural",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferhatural/mineClaude.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "dashboard",
    "monitor",
    "cli",
    "sessions"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mineclaude": "./server.js"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "once": "node server.js --once",
    "watch": "node server.js --watch",
    "app": "electron .",
    "app:build": "electron-builder --mac",
    "tray-icons": "node electron/make-tray-icons.js"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.github.ferhatural.mineclaude",
    "productName": "mineClaude",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "icons"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/assets/tray*.png",
      "term.js",
      "electron/pty.js",
      "server.js",
      "index.html",
      "office.js",
      "office3d.js",
      "office.css",
      "offline.html",
      "sw.js",
      "manifest.webmanifest",
      "icons/**",
      "vendor/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon-512.png",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "mineClaude, bir session'in calistigi terminal sekmesini one getirmek icin Terminal ve iTerm2'ye erisir."
      }
    }
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  }
}
