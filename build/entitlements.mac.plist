<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Notarization sertlestirilmis calisma zamanini (hardened runtime) zorunlu tutuyor,
  o da varsayilan olarak Electron'un ve node-pty'nin ihtiyaci olan seyleri yasakliyor.
  Buradaki dort izin tam olarak onlari geri aciyor:

  allow-jit / allow-unsigned-executable-memory
      V8 kodu calisma aninda uretiyor; bunlar olmadan Electron aciliste cokuyor.
  disable-library-validation
      node-pty kendi .node ikilisini ve spawn-helper'i yukluyor. Kutuphane
      dogrulamasi acikken ayni ekiple imzalanmamis hicbir seyi yukleyemiyor.
  allow-dyld-environment-variables
      Electron kendi cocuk sureclerini baslatirken dyld degiskenleri kullaniyor;
      gomulu terminaller bunun uzerinden aciliyor.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
